# 치지직 개발자센터(https://developers.chzzk.naver.com)에서 발급
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 애플리케이션 등록 시 입력한 "로그인 리디렉션 URL"과 정확히 일치해야 함
CHZZK_REDIRECT_URI=http://localhost:8080/callback

# 효과 프로필 (src/profiles/*.json): hexinton (기본, Hexinton All in One 테이블) | devpoland-hotkey (레거시)
PROFILE=hexinton
# 백엔드 강제 지정. 비워두면 프로필의 backend 사용. log = 아무것도 안 하고 콘솔만 (게임 없이 테스트)
BACKEND=
# 어댑터가 내부적으로 쓰는 포트 (가짜 후원 주입기 / OBS 오버레이)
ADAPTER_PORT=8008

# Hexinton 치트 테이블(.CT) 경로 — `npm run attach` 가 CE 에 자동으로 불러온다
HEXINTON_CT=
# Cheat Engine 실행 파일 (Scoop/Program Files 기본 경로가 아니면 지정)
CHEAT_ENGINE_EXE=
